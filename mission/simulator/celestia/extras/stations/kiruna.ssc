#--------------------------------------------------------------------------------
#
# Kiruna station file for Celestia with correct mask and X, Y and Z vectors.
#
# @remarks     Created.
# @author      Filipe Metelo <filipe.metelo @ esa.int>
# @version     2011.03.11
#
# @remarks     Added the X, Y and Z vectors, created the correct mask and automated orientation of the 3d mask model.
# @author      Filipe Metelo <filipe.metelo @ esa.int>
# @version     2011.03.23
#
#--------------------------------------------------------------------------------
"Kiruna" "Sol/Earth" {

    Class "surfacefeature"
    Mesh "kir-tm-mask-600km.3ds"
    NormalizeMesh false
    MeshCenter [ 0 0 0 ] # 3d model origin is [0 0 0]
    MeshScale 1000 # 3d model is in [km/1000]
    
    Emissive true
    # The 600 km telemetry visibility mask, drawn as a dome over the station.
    # Set this back to true to see the coverage volume.
    Visible false
    Radius 2000

    OrbitFrame {
        BodyFixed {
            Center "Sol/Earth"
        }
    }
    FixedPosition [ 2251.508244 862.66512 5885.477716 ]

    BodyFrame {
        TwoVector {
        Center "Sol/Earth/Kiruna"
            Primary {
                Axis "-y"
                RelativePosition {
                    Target "Sol/Earth"
                }
            }
            Secondary {
                Axis "-x"
                ConstantVector {
                    Frame {
                        BodyFixed {
                            Center "Sol/Earth"
                        }
                    }
                    Vector [ 0 0 1]
                }
            }
        }
    }
    FixedRotation {
        Inclination 0
        AscendingNode 0
        MeridianAngle 0
    }
}

