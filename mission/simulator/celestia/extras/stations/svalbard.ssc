#--------------------------------------------------------------------------------
#
# Svalbard station file for Celestia with correct mask and X, Y and Z vectors.
#
# @remarks     Created.
# @author      Filipe Metelo <filipe.metelo @ esa.int>
# @version     2011.03.11
#
# @remarks     Added the X, Y and Z vectors, created the correct mask and automated orientation of the 3d mask model.
# @author      Filipe Metelo <filipe.metelo @ esa.int>
# @version     2011.03.23
#
#--------------------------------------------------------------------------------
"Svalbard" "Sol/Earth" {

    Class "surfacefeature"
    Mesh "svl-tm-mask-600km.3ds"
    NormalizeMesh false
    MeshCenter [ 0 0 0 ] # 3d model origin is [0 0 0]
    MeshScale 1000 # 3d model is in [km/1000]
    
    Emissive true
    Visible true
    Radius 2000

    OrbitFrame {
        BodyFixed {
            Center "Sol/Earth"
        }
    }
    FixedPosition [ 1257.440285 345.816227 6221.710503 ]

    BodyFrame {
        TwoVector {
        Center "Sol/Earth/Svalbard"
            Primary {
                Axis "-y"
                RelativePosition {
                    Target "Sol/Earth"
                }
            }
            Secondary {
                Axis "-x"
                ConstantVector {
                    Frame {
                        BodyFixed {
                            Center "Sol/Earth"
                        }
                    }
                    Vector [ 0 0 1]
                }
            }
        }
    }
    FixedRotation {
        Inclination 0
        AscendingNode 0
        MeridianAngle 0
    }
}

