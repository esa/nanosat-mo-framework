                    </com:object>
                </com:objects>
                <com:events comment=""/>
                <com:activityUsage comment="Add the activity tracking for the progress of installation. Also for the Software Image service"/>
            </com:features>
        </mal:service>
        <mal:service name="Heartbeat" number="2" xsi:type="com:ExtendedServiceType" comment="The Heartbeat service provides the ability to periodically publish a heartbeat message. Additionally it is possible to get the period of the beat.">
            <mal:documentation name="Service-level Requirement" order="1">The Heartbeat service shall provide:
&lt;ol&gt;
&lt;li&gt;the capability for periodic monitoring of the beat;&lt;/li&gt;
&lt;li&gt;the capability for retrieving the period of the beat.&lt;/li&gt;
&lt;/ol&gt;
            </mal:documentation>
            <mal:capabilitySet number="1" comment="">
                <mal:pubsubIP name="beat" number="1" comment="The beat operation allows a provider to periodically send a heartbeat to the consumers.">
                    <mal:messages>
                        <mal:subscriptionKeys>
                        </mal:subscriptionKeys>
                        <mal:publishNotify>
                        </mal:publishNotify>
                    </mal:messages>
                </mal:pubsubIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="2" comment="">
                <mal:requestIP name="getPeriod" number="2" comment="The getPeriod operation allows a consumer to get the period of the provider's heartbeat.">
                    <mal:messages>
                        <mal:request>
                        </mal:request>
                        <mal:response>
                            <mal:field name="period" canBeNull="true" comment="The period of the heartbeat message.">
                                <mal:type area="MAL" list="false" name="Duration"/>
                            </mal:field>
                        </mal:response>
                    </mal:messages>
                </mal:requestIP>
            </mal:capabilitySet>
            <com:features/>
        </mal:service>
        <mal:service name="CommandExecutor" number="3" xsi:type="com:ExtendedServiceType" comment="The Command Executor service allows executing arbitrary system commands and monitoring their status.">
            <mal:documentation name="Service-level Requirement" order="1">
                The body of the Command COM object shall be of type Command.
            </mal:documentation>
            <mal:capabilitySet number="1" comment="">
                <mal:requestIP name="runCommand" number="1" comment="The runCommand operation allows a consumer to spawn a new shell instance and execute an arbitrary command on the provider host.">
                    <mal:messages>
                        <mal:request>
                            <mal:field name="command" canBeNull="true" comment="Details of the command to be run.">
                                <mal:type area="SM" list="false" name="Command"/>
                            </mal:field>
                        </mal:request>
                        <mal:response>
                            <mal:field name="commandId" canBeNull="true" comment="The COM id of the spawned command, as stored in the Archive.">
                                <mal:type area="MAL" list="false" name="Long"/>
                            </mal:field>
                        </mal:response>
                    </mal:messages>
                </mal:requestIP>
            </mal:capabilitySet>
            <com:features>
                <com:objects comment="The Command COM object used by the Command Executor service.">
                    <com:object comment="" number="1" name="Command">
                        <com:objectType>
                            <mal:type area="SM" list="false" name="Command"/>
                        </com:objectType>
                        <com:relatedObject comment=""/>
                        <com:sourceObject comment=""/>
                    </com:object>
                </com:objects>
                <com:events comment="">
                    <com:event comment="This event is produced to allow monitoring of the command stdout output. It contains a buffer of an arbitrary size with a chunk of stdout output." name="StandardOutput" number="2">
                        <com:objectType>
                            <mal:type area="MAL" list="false" name="String"/>
                        </com:objectType>
                        <com:relatedObject comment=""/>
                        <com:sourceObject comment="">
                            <com:objectType area="SM" number="1" service="CommandExecutor"/>
                        </com:sourceObject>
                    </com:event>
                    <com:event comment="This event is produced to allow monitoring of the command stderr output. It contains a buffer of an arbitrary size with a chunk of stderr output." name="StandardError" number="3">
                        <com:objectType>
                            <mal:type area="MAL" list="false" name="String"/>
                        </com:objectType>
                        <com:relatedObject comment=""/>
                        <com:sourceObject comment="">
                            <com:objectType area="SM" number="1" service="CommandExecutor"/>
                        </com:sourceObject>
                    </com:event>
                    <com:event comment="This event is produced to indicate that the command has finished its execution. Contains an exit code." name="ExecutionFinished" number="4">
                        <com:objectType>
                            <mal:type area="MAL" list="false" name="Integer"/>
                        </com:objectType>
                        <com:relatedObject comment=""/>
                        <com:sourceObject comment="">
                            <com:objectType area="SM" number="1" service="CommandExecutor"/>
                        </com:sourceObject>
                    </com:event>
                </com:events>
            </com:features>
        </mal:service>
        <mal:service name="AppsLauncher" number="5" xsi:type="com:ExtendedServiceType" comment="The Apps Launcher service provides the ability to monitor the execution, run, stop, kill and list applications software on-board of a spacecraft. The apps can be organized in categories.&#10;The service is independent from any particular Operating System or platform.">
            <mal:documentation name="Service-level Requirement" order="1">The Apps Launcher service shall provide:
&lt;ol&gt;
&lt;li&gt;the capability for periodic monitoring of the applications output;&lt;/li&gt;
&lt;li&gt;the capability for running and killing applications;&lt;/li&gt;
&lt;li&gt;the capability for stopping applications;&lt;/li&gt;
&lt;li&gt;the capability for listing the ids for the available apps.&lt;/li&gt;
&lt;/ol&gt;
            </mal:documentation>
            <mal:documentation name="Service-level Requirement" order="2">
                The body of the App COM object shall be of type AppDetails.
            </mal:documentation>
            <mal:documentation name="Service-level Requirement" order="3">
                The App COM object source link should point to the package from where the app was installed.
            </mal:documentation>

            <mal:capabilitySet number="1" comment="">
                <mal:pubsubIP name="monitorExecution" number="1" comment="The monitorExecution operation allows a consumer to subscribe for the application execution output stream.">
                    <mal:documentation name="Requirement" order="1">
                        The timestamp of the NOTIFY message shall be the on-board time at which it is published.
                    </mal:documentation>
                    <mal:documentation name="Requirement" order="2">
                        The PUBLISH message shall include the ObjectKey of the source link of the update.
                    </mal:documentation>
                    <mal:documentation name="Requirement" order="3">
                        If no source link is needed, then the service provider shall set the ObjectKey to NULL.
                    </mal:documentation>
                    <mal:messages>
                        <mal:subscriptionKeys>
                            <mal:field name="appName" canBeNull="false" comment="The App name.">
                                <mal:type area="MAL" list="false" name="Identifier"/>
                            </mal:field>
                            <mal:field name="appId" canBeNull="false" comment="The AppDetails id.">
                                <mal:type area="MAL" list="false" name="Long"/>
                            </mal:field>
                        </mal:subscriptionKeys>
                        <mal:publishNotify>
                            <mal:field name="outputStream" canBeNull="true" comment="The output stream of the application.">
                                <mal:type area="MAL" list="false" name="String"/>
                            </mal:field>
                        </mal:publishNotify>
                    </mal:messages>
                </mal:pubsubIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="2" comment="">
                <mal:submitIP name="runApp" number="2" comment="The runApp operation allows a consumer to run an application on the provider.">
                    <mal:messages>
                        <mal:submit>
                            <mal:field name="appIds" canBeNull="true" comment="The list of apps to run.">
                                <mal:type area="MAL" list="true" name="Long"/>
                            </mal:field>
                        </mal:submit>
                    </mal:messages>
                    <mal:errors>
                        <mal:errorRef comment="When one or more of the requested apps to run is unknown.">
                            <mal:type area="MAL" list="false" name="UNKNOWN"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                        <mal:errorRef comment="When one or more of the requested apps is already running.">
                            <mal:type area="COM" list="false" name="INVALID"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                        <mal:errorRef comment="When the process of the app could not be started.">
                            <mal:type area="MAL" list="false" name="INTERNAL"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                    </mal:errors>
                </mal:submitIP>
                <mal:submitIP name="killApp" number="3" comment="The killApp operation allows a consumer to kill the execution of an application on the provider in case an application becomes unresponsive.">
                    <mal:messages>
                        <mal:submit>
                            <mal:field name="appIds" canBeNull="true" comment="The list of apps to be killed.">
                                <mal:type area="MAL" list="true" name="Long"/>
                            </mal:field>
                        </mal:submit>
                    </mal:messages>
                    <mal:errors>
                        <mal:errorRef comment="When one or more of the requested apps to be killed is unknown.">
                            <mal:type area="MAL" list="false" name="UNKNOWN"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                        <mal:errorRef comment="When one or more of the requested apps is not running.">
                            <mal:type area="COM" list="false" name="INVALID"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                    </mal:errors>
                </mal:submitIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="3" comment="">
                <mal:progressIP name="stopApp" number="4" comment="The stopApp operation allows a consumer to stop the execution of an application on the provider.">
                    <mal:documentation name="Requirement" order="1">
                        The service provider shall send the UPDATE message after the app acknowledges the command to stop.
                    </mal:documentation>
                    <mal:messages>
                        <mal:progress>
                            <mal:field name="appIds" canBeNull="true" comment="The list of apps to stop.">
                                <mal:type area="MAL" list="true" name="Long"/>
                            </mal:field>
                        </mal:progress>
                        <mal:acknowledgement>
                        </mal:acknowledgement>
                        <mal:update>
                            <mal:field name="appClosing" canBeNull="true" comment="The id of the app that is closing.">
                                <mal:type area="MAL" list="false" name="Long"/>
                            </mal:field>
                        </mal:update>
                        <mal:response>
                        </mal:response>
                    </mal:messages>
                </mal:progressIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="4" comment="">
                <mal:requestIP name="listApp" number="5" comment="The listApp operation allows a consumer to request the ids of the Apps objects and running status for an app name or for a certain app category.">
                    <mal:documentation name="Requirement" order="1">
                        The service provider shall maintain the same order in the returned lists as the submitted appNames list unless the wildcard value was included in the request.
                    </mal:documentation>
                    <mal:messages>
                        <mal:request>
                            <mal:field name="appNames" canBeNull="true" comment="The list of application names.">
                                <mal:type area="MAL" list="true" name="Identifier"/>
                            </mal:field>
                            <mal:field name="category" canBeNull="true" comment="The category identifier to filter on.">
                                <mal:type area="MAL" list="false" name="Identifier"/>
                            </mal:field>
                        </mal:request>
                        <mal:response>
                            <mal:field name="appIds" canBeNull="true" comment="The list of apps.">
                                <mal:type area="MAL" list="true" name="Long"/>
                            </mal:field>
                            <mal:field name="running" canBeNull="true" comment="The running status of the requested apps.">
                                <mal:type area="MAL" list="true" name="Boolean"/>
                            </mal:field>
                        </mal:response>
                    </mal:messages>
                    <mal:errors>
                        <mal:errorRef comment="When one or more of the requested apps is unknown.">
                            <mal:type area="MAL" list="false" name="UNKNOWN"/>
                            <mal:extraInformation comment="The indexes of the error values.">
                                <mal:type area="MAL" list="true" name="UInteger"/>
                            </mal:extraInformation>
                        </mal:errorRef>
                    </mal:errors>
                </mal:requestIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="5" comment="">
                <mal:pubsubIP name="monitorEvents" number="6" comment="The monitorEvents operation allows a consumer to subscribe to app lifecycle events.">
                    <mal:messages>
                        <mal:subscriptionKeys>
                            <mal:field name="appName" canBeNull="false" comment="The name of the app to subscribe to, or wildcard for all apps.">
                                <mal:type area="MAL" list="false" name="Identifier"/>
                            </mal:field>
                            <mal:field name="appId" canBeNull="false" comment="The object instance identifier of the app, or wildcard for all apps.">
                                <mal:type area="MAL" list="false" name="Long"/>
                            </mal:field>
                        </mal:subscriptionKeys>
                        <mal:publishNotify>
                            <mal:field name="eventType" canBeNull="false" comment="The type of lifecycle event.">
                                <mal:type area="SM" list="false" name="AppEventType"/>
                            </mal:field>
                            <mal:field name="exitCode" canBeNull="true" comment="The process exit code. Non-NULL only for STOPPED, KILLED, EXITED, and CRASHED events.">
                                <mal:type area="MAL" list="false" name="Integer"/>
                            </mal:field>
                            <mal:field name="extraInfo" canBeNull="true" comment="Optional free-text information associated with the event, such as an error message or crash reason.">
                                <mal:type area="MAL" list="false" name="String"/>
                            </mal:field>
                        </mal:publishNotify>
                    </mal:messages>
