                <mal:field name="name" canBeNull="false" comment="The name of the package.">
                    <mal:type area="MAL" list="false" name="Identifier"/>
                </mal:field>
                <mal:field name="description" canBeNull="true" comment="The description of the package.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="category" canBeNull="false" comment="The category of the package.">
                    <mal:type area="MAL" list="false" name="Identifier"/>
                </mal:field>
