                <mal:field name="installed" canBeNull="true" comment="Whether the package is currently installed.">
                    <mal:type area="MAL" list="false" name="Boolean"/>
                </mal:field>
                <mal:field name="folderLocation" canBeNull="true" comment="The filesystem path of the folder where the package was installed.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
            </mal:composite>
            <mal:composite name="AppDetails" shortFormPart="3" comment="The details of an instance of an app.">
                <mal:extends>
                    <mal:type area="MAL" list="false" name="Composite"/>
                </mal:extends>
                <mal:field name="name" canBeNull="false" comment="The name of the app.">
                    <mal:type area="MAL" list="false" name="Identifier"/>
                </mal:field>
                <mal:field name="description" canBeNull="false" comment="The description of the app.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="version" canBeNull="false" comment="The version of the app.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="category" canBeNull="false" comment="The category of the app.">
                    <mal:type area="MAL" list="false" name="Identifier"/>
                </mal:field>
                <mal:field name="runAtStartup" canBeNull="false" comment="Controls whether the app runs at startup of the Supervisor.">
                    <mal:type area="MAL" list="false" name="Boolean"/>
                </mal:field>
                <mal:field name="running" canBeNull="false" comment="The current running state of the app.">
                    <mal:type area="MAL" list="false" name="Boolean"/>
                </mal:field>
                <mal:field name="extraInfo" canBeNull="true" comment="Additional information that might be implementation-specific.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="copyright" canBeNull="true" comment="The copyright of the app.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="runAs" canBeNull="true" comment="The user the app is run as.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
            </mal:composite>
            <mal:composite name="Command" shortFormPart="4" comment="The execution details of a command, including its status.">
                <mal:extends>
                    <mal:type area="MAL" list="false" name="Composite"/>
                </mal:extends>
                <mal:field name="command" canBeNull="false" comment="The command line passed to the executing shell instance.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
                <mal:field name="pid" canBeNull="true" comment="Assigned Process ID of the spawned shell instance. NULL if the execution has not started yet. -1 if the PID cannot be determined.">
                    <mal:type area="MAL" list="false" name="Long"/>
                </mal:field>
                <mal:field name="exitCode" canBeNull="true" comment="Exit code of the command. NULL if the execution has not completed yet.">
                    <mal:type area="MAL" list="false" name="Integer"/>
                </mal:field>
            </mal:composite>
