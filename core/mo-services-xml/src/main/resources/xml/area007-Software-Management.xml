                <mal:item nvalue="1" value="START_REQUESTED" comment="A request to start the app was received."/>
                <mal:item nvalue="2" value="STARTED"         comment="The app process started running."/>
                <mal:item nvalue="3" value="STOP_REQUESTED"  comment="A request to stop the app gracefully was received."/>
                <mal:item nvalue="4" value="STOPPED"         comment="The app stopped after a graceful stop request."/>
                <mal:item nvalue="5" value="KILLED"          comment="The app process was forcibly killed."/>
                <mal:item nvalue="6" value="EXITED"          comment="The app terminated on its own with exit code 0."/>
                <mal:item nvalue="7" value="CRASHED"         comment="The app terminated on its own with a non-zero exit code."/>
            </mal:enumeration>
