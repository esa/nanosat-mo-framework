                    <mal:type area="MAL" list="false" name="Integer"/>
                </mal:field>
                <mal:field name="extraInfo" canBeNull="true" comment="Optional free-text detail, such as a crash reason or error message.">
                    <mal:type area="MAL" list="false" name="String"/>
                </mal:field>
            </mal:composite>
