<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>int.esa.nmf</groupId>
        <artifactId>nanosat-mo-framework</artifactId>
        <version>5.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>int.esa.nmf.testbeds</groupId>
    <artifactId>testbed-e2e</artifactId>
    <packaging>jar</packaging>
    <name>ESA NMF Testbed - End-to-End</name>

    <organization>
        <name>ESA</name>
        <url>http://www.esa.int</url>
    </organization>

    <licenses>
        <license>
            <name>European Space Agency Public License (ESA-PL) Weak Copyleft – v2.4</name>
            <url>https://raw.github.com/esa/nanosat-mo-framework/master/LICENCE.md</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/esa/nanosat-mo-framework.git</connection>
        <url>https://github.com/esa/nanosat-mo-framework</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/esa/nanosat-mo-framework/issues</url>
    </issueManagement>

    <properties>
        <esa.nmf.version>5.1-SNAPSHOT</esa.nmf.version>
        <nmf.e2e.filesystem>${project.build.directory}/space-filesystem/nanosat-mo-framework</nmf.e2e.filesystem>

        <!-- The upgrade tests boot a second version, which means changing the
             baseline files and leaving a Supervisor of another version behind.
             They therefore work on a copy of the filesystem above, so that the
             other tests keep the single version they are written for. -->
        <nmf.e2e.filesystem.upgrade>${project.build.directory}/space-filesystem-upgrade/nanosat-mo-framework</nmf.e2e.filesystem.upgrade>

        <!-- The released version that the upgrade tests upgrade from, and the
             directory its Jars are staged into. -->
        <nmf.e2e.baseline.version>5.0</nmf.e2e.baseline.version>

        <!-- The MO version that the baseline above was released against. It
             tracks that release and not the version this build compiles with,
             so it does not move when the MO dependency is upgraded. It exists
             only while the baseline is staged Jar by Jar; see the comment on
             the stage-baseline-version-jars execution below. -->
        <nmf.e2e.baseline.mo.version>14.1</nmf.e2e.baseline.mo.version>
        <nmf.e2e.baseline.jars>${project.build.directory}/nmf-baseline-jars</nmf.e2e.baseline.jars>

        <!-- The released App package that the rollback test rolls back to. It is
             staged rather than built, so that the test rolls back to the very
             bytes that were published, and not to a rebuild of them. -->
        <nmf.e2e.baseline.apps>${project.build.directory}/nmf-baseline-apps</nmf.e2e.baseline.apps>

        <!-- The rollback test installs, rolls back and rolls forward an App, so
             it works on a copy of its own rather than leaving the App of the
             other tests on whichever version it finished on. -->
        <nmf.e2e.filesystem.rollback>${project.build.directory}/space-filesystem-rollback/nanosat-mo-framework</nmf.e2e.filesystem.rollback>

        <!-- The version of the App that the rollback test installs first and
             returns to last. Named here rather than read from whatever is
             installed, because the tests that run before it leave the App on
             versions of their own making. -->
        <nmf.e2e.current.version>${project.version}</nmf.e2e.current.version>
    </properties>

    <dependencies>
        <!-- Supervisor — used by generate-filesystem to classify JARs -->
        <dependency>
            <groupId>int.esa.nmf</groupId>
            <artifactId>barebone-nanosat-mo-supervisor</artifactId>
            <version>${esa.nmf.version}</version>
        </dependency>
        <!-- App under test -->
        <dependency>
            <groupId>int.esa.nmf.sdk</groupId>
            <artifactId>all-mc-services</artifactId>
            <version>${esa.nmf.version}</version>
            <type>nmfpack</type>
        </dependency>
        <!-- App with a self-exit action, used to test exit-code propagation -->
        <dependency>
            <groupId>int.esa.nmf.sdk</groupId>
            <artifactId>benchmark</artifactId>
            <version>${esa.nmf.version}</version>
            <type>nmfpack</type>
        </dependency>
        <!-- Deliberately misbehaving app: broken retrieval + hang on shutdown -->
        <dependency>
            <groupId>int.esa.nmf.testbeds</groupId>
            <artifactId>broken-app-for-testbeds</artifactId>
            <version>${esa.nmf.version}</version>
            <type>nmfpack</type>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${basedir}</directory>
                <includes>
                    <include>provider.properties</include>
                    <include>consumer.properties</include>
                    <include>transport.properties</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>int.esa.nmf.core</groupId>
                <artifactId>nmf-linux-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-e2e-filesystem</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>generate-filesystem</goal>
                        </goals>
                        <configuration>
                            <supervisorMainClass>esa.mo.nmf.mission.barebone.BareboneSupervisorImpl</supervisorMainClass>
                            <mission>
                                <missionName>Testbed</missionName>
                                <spacecraftName>Machine</spacecraftName>
                                <organizationAbbreviation>esa</organizationAbbreviation>
                                <organizationName>European Space Agency</organizationName>
                            </mission>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-e2e-apps</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>install-packages</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Stages the Jars of the released version that the
                         upgrade tests upgrade from. Resolved apart from the
                         dependencies of this module, so that the two versions
                         never meet on a classpath.

                         The set is listed by hand because 5.0 predates
                         nmf-core-package, so no released NMF Package holds it.
                         The goal below is copy rather than copy-dependencies,
                         which is what nmf-core-package uses to derive the same
                         set from a single dependency; copy resolves no
                         transitive dependency, and declaring the baseline as a
                         dependency of this module is what the paragraph above
                         rules out.

                         Once the baseline is a version that publishes an NMF
                         Package, this whole execution becomes one artifactItem
                         for that package, and nmf.e2e.baseline.mo.version is
                         then unused and to be deleted. -->
                    <execution>
                        <id>stage-baseline-version-jars</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>api-area001-v003-mal</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>encoding-binary</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>encoding-string</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>mal-impl</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>transport-generic</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>transport-rmi</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.ccsds.mo</groupId>
                                    <artifactId>transport-tcpip</artifactId>
                                    <version>${nmf.e2e.baseline.mo.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf</groupId>
                                    <artifactId>barebone-nanosat-mo-supervisor</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>api-nmf-com</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>api-nmf-mc</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>api-nmf-platform</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>api-nmf-sm</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>mo-services-xml</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>nmf-composites</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>nmf-package-lib</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>int.esa.nmf.core</groupId>
                                    <artifactId>nmf-services-impl</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.xerial</groupId>
                                    <artifactId>sqlite-jdbc</artifactId>
                                    <version>3.49.1.0</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${nmf.e2e.baseline.jars}</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                    <!-- Stages the released App package that the rollback test
                         rolls back to. One artifactItem is enough here: an App
                         package carries its own dependencies, so nothing has to
                         be resolved transitively. -->
                    <execution>
                        <id>stage-baseline-app-package</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>int.esa.nmf.sdk</groupId>
                                    <artifactId>benchmark</artifactId>
                                    <version>${nmf.e2e.baseline.version}</version>
                                    <type>nmfpack</type>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${nmf.e2e.baseline.apps}</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <nmf.e2e.filesystem>${nmf.e2e.filesystem}</nmf.e2e.filesystem>
                        <nmf.e2e.filesystem.upgrade>${nmf.e2e.filesystem.upgrade}</nmf.e2e.filesystem.upgrade>
                        <nmf.e2e.baseline.jars>${nmf.e2e.baseline.jars}</nmf.e2e.baseline.jars>
                        <nmf.e2e.baseline.version>${nmf.e2e.baseline.version}</nmf.e2e.baseline.version>
                        <nmf.e2e.baseline.apps>${nmf.e2e.baseline.apps}</nmf.e2e.baseline.apps>
                        <nmf.e2e.filesystem.rollback>${nmf.e2e.filesystem.rollback}</nmf.e2e.filesystem.rollback>
                        <nmf.e2e.current.version>${nmf.e2e.current.version}</nmf.e2e.current.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
