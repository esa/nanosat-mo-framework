<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>int.esa.nmf</groupId>
        <artifactId>nanosat-mo-framework</artifactId>
        <version>5.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>int.esa.nmf.testbeds</groupId>
    <artifactId>testbed-performance</artifactId>
    <packaging>jar</packaging>
    <name>ESA NMF Testbed - Performance</name>

    <organization>
        <name>ESA</name>
        <url>http://www.esa.int</url>
    </organization>

    <licenses>
        <license>
            <name>European Space Agency Public License (ESA-PL) Weak Copyleft – v2.4</name>
            <url>https://raw.github.com/esa/nanosat-mo-framework/master/LICENCE.md</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/esa/nanosat-mo-framework.git</connection>
        <url>https://github.com/esa/nanosat-mo-framework</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/esa/nanosat-mo-framework/issues</url>
    </issueManagement>

    <properties>
        <esa.nmf.version>5.0-SNAPSHOT</esa.nmf.version>
        <nmf.perf.filesystem>${project.build.directory}/space-filesystem/nanosat-mo-framework</nmf.perf.filesystem>
        <nmf.perf.cli.jar>${project.build.directory}/cli-tool.jar</nmf.perf.cli.jar>
        <nmf.perf.results>${project.build.directory}/performance-results.txt</nmf.perf.results>
    </properties>

    <dependencies>
        <!-- Supervisor — used by generate-filesystem to classify JARs -->
        <dependency>
            <groupId>int.esa.nmf</groupId>
            <artifactId>barebone-nanosat-mo-supervisor</artifactId>
            <version>${esa.nmf.version}</version>
        </dependency>
        <!-- CLI fat jar — copied to target/ by maven-dependency-plugin -->
        <dependency>
            <groupId>int.esa.nmf.sdk</groupId>
            <artifactId>cli-tool</artifactId>
            <version>${esa.nmf.version}</version>
            <classifier>jar-with-dependencies</classifier>
            <scope>provided</scope>
        </dependency>
        <!-- App under test for run/stop performance measurement -->
        <dependency>
            <groupId>int.esa.nmf.sdk</groupId>
            <artifactId>benchmark</artifactId>
            <version>${esa.nmf.version}</version>
            <type>nmfpack</type>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${basedir}</directory>
                <includes>
                    <include>provider.properties</include>
                    <include>consumer.properties</include>
                    <include>transport.properties</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <!-- Copy the CLI fat jar to target/ so the test can locate it via a fixed path -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-cli-jar</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>int.esa.nmf.sdk</groupId>
                                    <artifactId>cli-tool</artifactId>
                                    <version>${esa.nmf.version}</version>
                                    <classifier>jar-with-dependencies</classifier>
                                    <destFileName>cli-tool.jar</destFileName>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>int.esa.nmf.core</groupId>
                <artifactId>nmf-linux-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-perf-filesystem</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>generate-filesystem</goal>
                        </goals>
                        <configuration>
                            <supervisorMainClass>esa.mo.nmf.mission.barebone.BareboneSupervisorImpl</supervisorMainClass>
                            <mission>
                                <missionName>Testbed</missionName>
                                <spacecraftName>Machine</spacecraftName>
                                <organizationAbbreviation>ESA</organizationAbbreviation>
                                <organizationName>European Space Agency</organizationName>
                            </mission>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-perf-apps</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>install-packages</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <nmf.perf.filesystem>${nmf.perf.filesystem}</nmf.perf.filesystem>
                        <nmf.perf.cli.jar>${nmf.perf.cli.jar}</nmf.perf.cli.jar>
                        <nmf.perf.results>${nmf.perf.results}</nmf.perf.results>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
