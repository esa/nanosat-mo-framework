"Velocity" "Sol/Earth/cubesat-1"
{
    Class "surfacefeature"
    Mesh "violet-vector.3ds"
    NormalizeMesh false
    MeshCenter [ 0 0 0 ] # 3d model origin is [0 0 0]
    MeshScale 40 # 3d model is in [km/1000]
    Emissive true

    Visible true
    Radius 40

    OrbitFrame {
        BodyFixed {
            Center "Sol/Earth/cubesat-1"
        }
    }
    FixedPosition [ 0 0 0 ]
    
    BodyFrame {
        TwoVector {
            Center "Sol/Earth/cubesat-1"
            Primary {
                Axis "y"
                RelativePosition {
                    Target "Sol/Earth/cubesat-1-Prop"
                }
            }
            Secondary {
                Axis "z"
                RelativePosition {
                    Target "Sol/Earth"
                }
            }
        }
    }
    FixedRotation {
        Inclination 0
        AscendingNode 0
        MeridianAngle 0
    }
}

"Earth" "Sol/Earth/cubesat-1"
{
    Class "surfacefeature"
    Mesh "cyan-vector.3ds"
    NormalizeMesh false
    MeshCenter [ 0 0 0 ] # 3d model origin is [0 0 0]
    MeshScale 40 # 3d model is in [km/1000]
    Emissive true

    Visible true
    Radius 40

    OrbitFrame {
        BodyFixed {
            Center "Sol/Earth/cubesat-1"
        }
    }
    FixedPosition [ 0 0 0 ]

    BodyFrame {
        TwoVector {
            Center "Sol/Earth/cubesat-1"
            Primary {
                Axis "y"
                RelativePosition {
                    Target "Sol/Earth"
                }
            }
            Secondary {
                Axis "z"
                ConstantVector {
                    Frame {
                        BodyFixed {
                            Center "Sol/Earth/cubesat-1"
                        }
                    }
                    Vector [ 0 0 1 ]
                }
            }
        }
    }
    FixedRotation {
        Inclination 0
        AscendingNode 0
        MeridianAngle 0
    }
}

