<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>int.esa.nmf.security</groupId>
        <artifactId>security-toolkit</artifactId>
        <version>6.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app-directory-probe</artifactId>
    <packaging>jar</packaging>

    <name>ESA NMF Security Toolkit - Directory Probe App</name>
    <description>
        A benign NMF App that tries to take over the Supervisor's entry in the Directory service
        (NMF-2026-011) and reports what a look-up of the Supervisor then finds. It is packaged
        twice: as directory-probe, which adds an entry under the Supervisor's name itself, and as
        nanosat-mo-supervisor, which only registers under its own name, as every App does.
    </description>

    <properties>
        <assembly.mainClass>esa.mo.nmf.security.probe.DirectoryProbe</assembly.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>int.esa.nmf.core</groupId>
            <artifactId>nmf-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources></resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>int.esa.nmf.core</groupId>
                <artifactId>nmf-package-maven-plugin</artifactId>
                <executions>
                    <!-- An App that adds an entry under the Supervisor's name itself -->
                    <execution>
                        <id>directory-probe</id>
                        <phase>package</phase>
                        <goals>
                            <goal>generate-nmf-package</goal>
                        </goals>
                        <configuration>
                            <name>directory-probe</name>
                            <mainClass>${assembly.mainClass}</mainClass>
                        </configuration>
                    </execution>
                    <!-- An App named after the Supervisor, which only registers as every App does -->
                    <execution>
                        <id>named-after-the-supervisor</id>
                        <phase>package</phase>
                        <goals>
                            <goal>generate-nmf-package</goal>
                        </goals>
                        <configuration>
                            <name>nanosat-mo-supervisor</name>
                            <mainClass>${assembly.mainClass}</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
